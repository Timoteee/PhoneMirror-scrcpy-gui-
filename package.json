{
  "name": "phone-mirror",
  "version": "1.0.0",
  "private": true,
  "description": "A Windows desktop app that mirrors an Android phone with scrcpy.",
  "author": "Timoteee",
  "copyright": "Copyright (c) 2026 Timoteee",
  "license": "MIT",
  "homepage": "https://github.com/Timoteee/PhoneMirror-scrcpy-gui-#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Timoteee/PhoneMirror-scrcpy-gui-.git"
  },
  "bugs": {
    "url": "https://github.com/Timoteee/PhoneMirror-scrcpy-gui-/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node scripts/fetch-scrcpy.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/fetch-scrcpy.mjs",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run build && electron-builder --win --x64",
    "icon": "python3 scripts/make-icon.py",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
